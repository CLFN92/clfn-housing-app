{
  // Cloudflare Worker config for the PLATFORM ADMIN panel (admin.fnhub.app).
  // Separate Worker from the nation app: a distinct name + its own custom
  // domain, serving ONLY the admin/ folder as static assets. This keeps the
  // control plane isolated from the nation site (they share the repo today but
  // deploy as two independent Workers; the admin/ folder can move to its own
  // repo later with no change here beyond the path).
  //
  // The nation app's root wrangler.jsonc serves "." and excludes admin/ via
  // .assetsignore, so the panel is never exposed on fnhub.app / *.fnhub.app --
  // only on this Worker's admin.fnhub.app domain.
  //
  // Cloudflare Workers Build deploy command for THIS project:
  //   npx wrangler deploy -c wrangler.admin.jsonc
  "name": "fnhub-admin",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "admin"
  }
  // NOTE: the admin.fnhub.app custom domain is bound to this Worker ONCE, in the
  // Cloudflare dashboard (Workers & Pages -> fnhub-admin -> Settings -> Domains).
  // We deliberately do NOT declare it as a route here: a `custom_domain: true`
  // route makes every `wrangler deploy` reconcile the binding via the zone
  // Workers-Routes API, which fails (Authentication error 10000) unless the
  // CLOUDFLARE_API_TOKEN carries the Zone -> Workers Routes -> Edit permission --
  // turning every admin deploy red even though the Worker + assets uploaded
  // fine. Once the custom domain is bound, `wrangler deploy` promotes the new
  // version and the existing binding serves it automatically, so the route
  // declaration is unnecessary. If you ever need wrangler to manage the binding
  // again, add that token permission first, then restore the "routes" block.
}
