{
  "routes": [
    {
      "route": "/",
      "serve": "/index.html",
      "statusCode": 200
    },
    {
      "route": "/housing.html",
      "serve": "/housing.html",
      "statusCode": 200
    },
    {
      "route": "/inventory.html",
      "serve": "/inventory.html",
      "statusCode": 200
    },
    {
      "route": "/match.html",
      "serve": "/match.html",
      "statusCode": 200
    },
    {
      "route": "/tenants.html",
      "serve": "/tenants.html",
      "statusCode": 200
    },
    {
      "route": "/renos.html",
      "serve": "/renos.html",
      "statusCode": 200
    },
    {
      "route": "/finance.html",
      "serve": "/finance.html",
      "statusCode": 200
    },
    {
      "route": "/contractors.html",
      "serve": "/contractors.html",
      "statusCode": 200
    },
    {
      "route": "/rfq.html",
      "serve": "/rfq.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "*.css",
      "*.js",
      "*.png",
      "*.jpg",
      "*.json",
      "*.html",
      "*.pdf"
    ]
  },
  "mimeTypes": {
    ".html": "text/html",
    ".json": "application/json",
    ".pdf":  "application/pdf"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  }
}