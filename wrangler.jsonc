{
  // Cloudflare Worker config for the nation app (fnhub.app / *.fnhub.app).
  // This is a STATIC-ASSETS worker: no server code, just the repo's HTML/CSS/JS
  // served as-is. The assets directory is the repo root ("."), and .assetsignore
  // filters out everything that must NOT be public (.git, supabase, docs, *.md,
  // *.sql, the admin/ panel, and these wrangler config files themselves).
  //
  // The Cloudflare "Workers Builds" deploy command (npx wrangler versions upload)
  // was failing with "Missing entry-point to Worker script or to assets
  // directory" because this file did not exist. `name` must match the existing
  // Worker so uploads target the same one.
  "name": "clfn-housing-app",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "."
  }
}
